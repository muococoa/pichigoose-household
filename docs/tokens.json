{
  "$description": "Pichigoose design tokens, Scrapbook direction. Source of truth for the household app. Values in px unless noted.",
  "color": {
    "brand": {
      "hero": "#D34471",
      "heroDark": "#A8335A",
      "orange": "#F2A03D",
      "violet": "#8466B8",
      "lilac": "#D6C8E6",
      "butter": "#F8E6A8"
    },
    "status": {
      "success": "#6E9152",
      "successDark": "#4E6B39",
      "info": "#3B6FA0"
    },
    "paper": {
      "page": "#FFFDF8",
      "rule": "#E6DFE3",
      "margin": "rgba(211,68,113,0.22)",
      "innerRow": "#EEE8F5",
      "white": "#FFFFFF"
    },
    "ink": {
      "headline": "#1E1A30",
      "body": "#2E2638",
      "muted": "#63586B",
      "faint": "#857A8C",
      "dashed": "#B6ABBE"
    },
    "neutralRamp": {
      "$description": "Nora's purple-gray from her Procreate palette. Used for the pens: text and lines.",
      "0": "#FFFDF8", "50": "#F6F0E8", "100": "#E6DFE3", "200": "#CBC2CC", "300": "#A79DAC",
      "400": "#857A8C", "500": "#63586B", "600": "#463D50", "700": "#2E2638", "800": "#1E1A30"
    },
    "note": {
      "blush": "#F2C1C4",
      "peach": "#F6CFA0",
      "butter": "#F8E6A8",
      "mist": "#DCE7F0",
      "sand": "#E9E1D6",
      "sage": "#CFDDB8",
      "mint": "#A7D3CC",
      "lilac": "#D6C8E6"
    },
    "stamp": {
      "nora": "#A8335A",
      "claude": "#63586B",
      "locked": "#4E6B39",
      "draft": "#8C5A3C",
      "open": "#3B6FA0"
    },
    "money": {
      "iOwe": "#A8335A",
      "owedToMe": "#4E6B39"
    }
  },
  "font": {
    "ui": "Nunito",
    "hand": "Caveat",
    "handNote": "Caveat is a stand-in until Nora's own hand lettering becomes a font"
  },
  "type": {
    "display": { "family": "Nunito", "size": 40, "lineHeight": 48, "weight": 800 },
    "h1": { "family": "Nunito", "size": 32, "lineHeight": 40, "weight": 800 },
    "h2": { "family": "Nunito", "size": 24, "lineHeight": 32, "weight": 700 },
    "body": { "family": "Nunito", "size": 16, "lineHeight": 24, "weight": 500 },
    "bodyStrong": { "family": "Nunito", "size": 16, "lineHeight": 24, "weight": 600 },
    "small": { "family": "Nunito", "size": 14, "lineHeight": 20, "weight": 500 },
    "caption": { "family": "Nunito", "size": 12, "lineHeight": 16, "weight": 600 },
    "button": { "family": "Nunito", "size": 16, "lineHeight": 20, "weight": 800 },
    "tab": { "family": "Nunito", "size": 11, "lineHeight": 14, "weight": 700 },
    "stamp": { "family": "Nunito", "size": 11, "lineHeight": 14, "weight": 800, "letterSpacing": 0.66, "transform": "uppercase" },
    "handScreenTitle": { "family": "Caveat", "size": 42, "lineHeight": 44, "weight": 700 },
    "handSection": { "family": "Caveat", "size": 30, "lineHeight": 32, "weight": 700 },
    "handRow": { "family": "Caveat", "size": 28, "lineHeight": 30, "weight": 700 },
    "handGreeting": { "family": "Caveat", "size": 22, "lineHeight": 24, "weight": 700 }
  },
  "space": { "xs": 4, "s": 8, "m": 12, "l": 16, "xl": 22, "xxl": 32 },
  "layout": {
    "screenWidth": 390,
    "statusBar": 44,
    "pagePaddingLeft": 40,
    "pagePaddingRight": 22,
    "marginLineX": 26,
    "marginLineWidth": 2,
    "ruleSpacing": 32,
    "ruleOffset": 6,
    "tabBarHeight": 84,
    "sectionGap": 22
  },
  "radius": {
    "speechBubble": [14, 16, 14, 4],
    "input": [14, 22, 16, 20],
    "stamp": 5,
    "checkbox": 5,
    "avatar": "50%"
  },
  "stroke": {
    "line": 2,
    "check": 2.5,
    "checkColor": "#D34471"
  },
  "shadow": {
    "note": { "x": 2, "y": 3, "blur": 0, "color": "rgba(30,26,48,0.13)" },
    "noteLifted": { "x": 4, "y": 10, "blur": 14, "color": "rgba(30,26,48,0.22)" },
    "sticker": [
      { "x": 0, "y": 0, "blur": 0, "spread": 1, "color": "rgba(30,26,48,0.10)" },
      { "x": 2, "y": 3, "blur": 4, "color": "rgba(30,26,48,0.22)" }
    ],
    "avatar": [
      { "x": 0, "y": 0, "blur": 0, "spread": 2, "color": "#FFFFFF" },
      { "x": 1, "y": 2, "blur": 2, "spread": 1, "color": "rgba(30,26,48,0.15)" }
    ],
    "tabBar": { "x": 0, "y": -6, "blur": 14, "color": "rgba(30,26,48,0.08)" }
  },
  "sticker": {
    "border": { "width": 4, "widthSmall": 3, "color": "#FFFFFF" },
    "height": { "regular": 48, "small": 38, "round": 62 },
    "paddingX": { "regular": 22, "small": 14 },
    "handCutRadius": "8 30 12 26 / 26 10 30 14 (elliptical, horizontal / vertical, clockwise from top left)",
    "handCutRoundRadius": "58% 38% 54% 40% / 40% 56% 38% 58%",
    "primary": { "background": "#D34471", "text": "#FFFFFF" },
    "secondary": { "background": "#FFFDF8", "text": "#1E1A30" },
    "people": { "background": "#8466B8", "text": "#FFFFFF", "use": "Second hero color. Anything about people: inviting, joining." },
    "disabled": { "background": "#E6DFE3", "text": "#857A8C" }
  },
  "avatar": {
    "sizeRow": 34,
    "sizeHeader": 40,
    "lineWidth": 2,
    "characterBackgrounds": ["blush", "mint", "mist", "sage", "peach", "butter", "lilac", "sand"]
  },
  "washi": {
    "height": 22,
    "width": 84,
    "stripeWidth": 8,
    "patterns": {
      "pink": "stripes 45deg rgba(242,193,196,.9) / rgba(255,253,248,.7)",
      "yellow": "stripes 45deg rgba(248,230,168,.95) / rgba(255,253,248,.7)",
      "mint": "stripes 45deg rgba(167,211,204,.9) / rgba(255,253,248,.7)",
      "blue": "stripes 45deg rgba(201,211,240,.95) / rgba(255,253,248,.7)",
      "dots": "dots rgba(211,68,113,.5) on rgba(242,193,196,.85), 11px grid",
      "blocks": "vertical blocks rgba(132,102,184,.4) on rgba(214,200,230,.9), 18px",
      "triangles": "triangles rgba(242,160,61,.55) on rgba(248,230,168,.9), 16px",
      "check": "gingham rgba(110,145,82,.35) on rgba(207,221,184,.9), 12px"
    }
  },
  "texture": {
    "paper": { "file": "assets/paper-white.png", "tile": 512, "use": "repeat over the page color, under the ruled lines' content" },
    "note": { "file": "assets/note-fresh.png", "tile": 512, "blend": "multiply", "use": "over every sticky note" },
    "ink": { "file": "assets/ink-patch.png", "tile": 420, "use": "alpha mask on hand headlines, shifted per headline" },
    "stamp": { "file": "assets/stamp-grunge.png", "tile": 300, "use": "alpha mask on stamps, shifted per stamp" }
  },
  "motion": {
    "pickUpRotate": "-3deg",
    "pickUpTranslate": [8, -2],
    "noteRotationRange": "-1.5deg to 1.5deg",
    "checkboxRotationRange": "-2deg to 2deg"
  }
}
