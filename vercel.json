{
  "rewrites": [
    {
      "source": "/join/:address",
      "destination": "/join.html"
    },
    {
      "source": "/join/:address/:secret",
      "destination": "/join.html"
    },
    {
      "source": "/((?!assets/|email/|og/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "claude/brave-newton-io3klv": false
    }
  }
}
